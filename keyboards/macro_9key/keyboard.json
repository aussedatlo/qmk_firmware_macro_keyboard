{
    "keyboard_name": "Macro 9-Key",
    "manufacturer": "Custom",
    "maintainer": "qmk",
    "usb": {
        "vid": "0xFEED",
        "pid": "0x6091",
        "device_version": "0.0.1"
    },
    "features": {
        "bootmagic": true,
        "command": true,
        "console": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": false
    },
    "matrix_pins": {
        "cols": ["B2", "B3", "B1", "F7"],
        "rows": ["D0", "D4"]
    },
    "diode_direction": "ROW2COL",
    "processor": "atmega32u4",
    "bootloader": "caterina",
    "debounce": 5,
    "encoder": {
        "rotary": [
            { "pin_a": "F6", "pin_b": "F5" }
        ],
        "presses": ["F4"],
        "resolution": 4
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [0, 3], "x": 3, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [1, 3], "x": 3, "y": 1}
            ]
        }
    }
}

